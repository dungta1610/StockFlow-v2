# Copy to .env at the repo root. Never commit .env.
# Values here work for host-run development (pnpm dev:api) against the compose
# infra; inside compose the api service overrides hosts with service names.

# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
# HTTP port of the API.
PORT=3100
# Browser origins allowed by CORS (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Auth ─────────────────────────────────────────────────────────────
# HS256 key for access tokens, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Failed logins allowed per account / per client IP within the window.
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_SECONDS=900

# ── Ordering ─────────────────────────────────────────────────────────
# Minutes a new order holds its stock before it may be expired and the stock released.
ORDER_RESERVATION_TTL_MINUTES=30

# ── Demo data (pnpm seed / compose migrate service) ──────────────────
# Creates demo organisations and accounts sharing SEED_PASSWORD. Never in production.
SEED_ALLOW=true
SEED_PASSWORD=ChangeMe-123!

# ── Postgres (pgvector) ──────────────────────────────────────────────
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow
POSTGRES_DB=stockflow
# Host port for the compose Postgres (5432 is often taken by other projects).
POSTGRES_PORT=5433
DATABASE_URL=postgres://stockflow:stockflow@localhost:5433/stockflow
# Per-connection guards (see docs/adr/0004).
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_POOL_MAX=20

# ── Redis ────────────────────────────────────────────────────────────
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
# Global limiter: requests per window per client IP + route (StockFlow defaults).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── LiteLLM → AWS Bedrock ────────────────────────────────────────────
LITELLM_PORT=4001
LITELLM_BASE_URL=http://localhost:4001
# Master key for the local LiteLLM proxy (any string for local use).
LITELLM_API_KEY=sk-stockflow-dev-change-me
# Bedrock region. us-east-1 carries both Claude Haiku 4.5 and Cohere Embed v3.
AWS_REGION_NAME=us-east-1
# Provide EITHER IAM credentials …
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# … OR a single Bedrock API key.
AWS_BEARER_TOKEN_BEDROCK=

# ── Published ports for the full compose stack ───────────────────────
API_PORT=3100
WEB_PORT=8080
