{
  "name": "stockflow-v2",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @stockflow/api start:dev",
    "dev:web": "pnpm --filter @stockflow/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm --filter @stockflow/api test",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "spike:bedrock": "tsx scripts/spike-bedrock.mts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@strands-agents/sdk": "^1.18.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.39.0",
    "openai": "^6.48.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "zod": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.1.0",
      "@types/pg": "8.23.1"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "@nestjs/core",
      "ssh2",
      "cpu-features",
      "protobufjs"
    ]
  }
}
